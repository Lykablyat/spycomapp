{
  "expo": {
    "name": "SpyCom",
    "slug": "spycomapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-spycom.png",
    "scheme": "spycomapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.ledger.spycomapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080C14",
        "foregroundImage": "./assets/images/icon-spycom.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.ledger.spycomapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080C14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 1
        }
      ],
      "expo-font",
      "expo-sqlite",
      "react-native-quick-crypto",
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": [
                "lib/x86/libcrypto.so",
                "lib/x86_64/libcrypto.so",
                "lib/armeabi-v7a/libcrypto.so",
                "lib/arm64-v8a/libcrypto.so",
                "lib/x86/libssl.so",
                "lib/x86_64/libssl.so",
                "lib/armeabi-v7a/libssl.so",
                "lib/arm64-v8a/libssl.so"
              ]
            }
          }
        }
      ],
      [
        "@howincodes/expo-dynamic-app-icon",
        {
          "default": {
            "android": {
              "foregroundImage": "./assets/images/icon-spycom.png",
              "backgroundColor": "#080C14",
              "label": "SpyCom"
            }
          },
          "calculator": {
            "android": {
              "foregroundImage": "./assets/images/icon-calculator.png",
              "backgroundColor": "#FFFFFF",
              "label": "Calculator"
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6dd6a0b3-b5da-47d4-8a97-e74d4aede94a"
      }
    }
  }
}
